{
  "name": "debug",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.server.json && vite build",
    "dev": "tsx scripts/dev.ts",
    "lint": "oxlint src server scripts tests",
    "lint:fix": "oxlint --write src server scripts tests",
    "start": "node dist-server/server/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@zcode/shared": "workspace:*",
    "hono": "^4.13.17",
    "http-mitm-proxy": "^1.1.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vis-timeline": "^8.5.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^4.1.5"
  }
}
