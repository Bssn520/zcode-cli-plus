{
  "name": "zcode-cli-plus-workspace",
  "version": "3.15.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --dir apps/zcode-cli build",
    "cli:build": "pnpm --dir apps/zcode-cli cli:build",
    "test": "pnpm --dir apps/zcode-cli test",
    "test:ci": "bash ci/test-known-failures.sh",
    "typecheck": "pnpm --dir apps/zcode-cli typecheck",
    "lint": "oxlint",
    "ci:local": "bash ci/run-ci-local.sh",
    "build:sea": "pnpm --dir apps/zcode-cli build:sea",
    "build:sea:all": "pnpm install && pnpm --dir apps/zcode-cli build:sea",
    "release:cli": "pnpm --dir apps/zcode-cli run release",
    "release:cli:dry": "pnpm --dir apps/zcode-cli run release:dry"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "postject": "1.0.0-alpha.6",
    "release-it": "^21.1.1",
    "@release-it/conventional-changelog": "^12.0.2",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "conventional-changelog-writer": "^9.3.0",
    "dotenv": "^18.0.7"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "overrides": {
      "react": "19.2.7",
      "react-dom": "19.2.7"
    },
    "patchedDependencies": {
      "vitest@4.1.7": "patches/vitest@4.1.7.patch",
      "@ai-sdk/openai-compatible@2.0.60": "patches/@ai-sdk__openai-compatible@2.0.60.patch",
      "@ai-sdk/anthropic@3.0.81": "patches/@ai-sdk__anthropic@3.0.81.patch"
    }
  },
  "license": "Apache-2.0"
}
